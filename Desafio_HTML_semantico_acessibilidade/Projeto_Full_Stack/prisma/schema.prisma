// schema.prisma — Aula 17: Persistência de Dados
// ORM: Prisma | Banco: SQLite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Entidade: Feedback
// Campos: id (autoincremento) + texto (string)
model Feedback {
  id        Int      @id @default(autoincrement())
  texto     String
  criadoEm DateTime @default(now())
}
